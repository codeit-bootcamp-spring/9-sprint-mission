      "name": "User 등록",
      "item": [
        {
          "name": "User 등록 - alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('id 존재', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('username 일치', () => pm.expect(body.username).to.eql('alice'));",
                  "pm.test('email 일치', () => pm.expect(body.email).to.eql('alice@test.com'));",
                  "pm.test('profileId 필드 존재', () => pm.expect(body).to.have.property('profileId'));",
                  "pm.test('createdAt 존재', () => pm.expect(body.createdAt).to.be.a('string'));",
                  "pm.collectionVariables.set('user1Id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userCreateRequest",
                  "value": "{\"username\": \"alice\", \"email\": \"alice@test.com\", \"password\": \"pass123\"}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            }
          }
        },
