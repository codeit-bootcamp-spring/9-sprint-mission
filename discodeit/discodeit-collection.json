    {
      "name": "Message",
      "item": [
        {
          "name": "Message 생성",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const channelId = pm.collectionVariables.get('channel1Id');",
                  "const authorId = pm.collectionVariables.get('user1Id');",
                  "const req = JSON.stringify({ content: 'Hello World', channelId, authorId });",
                  "pm.request.body.formdata.each(fd => {",
                  "  if (fd.key === 'messageCreateRequest') fd.value = req;",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('id 존재', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('content 일치', () => pm.expect(body.content).to.eql('Hello World'));",
                  "pm.test('channelId 존재', () => pm.expect(body.channelId).to.be.a('string'));",
                  "pm.test('authorId 존재', () => pm.expect(body.authorId).to.be.a('string'));",
                  "pm.test('attachmentIds 배열', () => pm.expect(body.attachmentIds).to.be.an('array'));",
                  "pm.collectionVariables.set('message1Id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/messages",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "messageCreateRequest",
                  "value": "{\"content\": \"Hello World\", \"channelId\": \"placeholder\", \"authorId\": \"placeholder\"}",
                  "type": "text",
                  "contentType": "application/json"
