{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Path aliases */
    "baseUrl": "../../../../Downloads/0-sprint-mission-front-1.2.4",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "../../../../Downloads/0-sprint-mission-front-1.2.4/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
} 