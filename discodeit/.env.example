# App
SPRING_PROFILES_ACTIVE=prod
APP_HOST_PORT=8081
DISCODEIT_REMEMBER_ME_KEY=change-this-to-a-long-random-secret

# PostgreSQL
POSTGRES_DB=discodeit
DB_USER=discodeit_user
DB_PASSWORD=discodeit1234
POSTGRES_HOST_PORT=5433

# Redis / Kafka
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LISTENER_AUTO_STARTUP=false

# Admin account for dev profile
DISCODEIT_ADMIN_ENABLED=true
DISCODEIT_ADMIN_USERNAME=admin
DISCODEIT_ADMIN_EMAIL=admin@discodeit.local
DISCODEIT_ADMIN_PASSWORD=dev-admin-password-change-me

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=/app/storage

# AWS S3 (required only when STORAGE_TYPE=s3)
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRATION=600
