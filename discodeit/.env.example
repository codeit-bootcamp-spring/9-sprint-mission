# App
SPRING_PROFILES_ACTIVE=prod
APP_HOST_PORT=8081
DISCODEIT_REMEMBER_ME_KEY=change-this-to-a-long-random-secret

# PostgreSQL
POSTGRES_DB=discodeit
DB_USER=discodeit_user
DB_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=/app/storage

# AWS S3 (required only when STORAGE_TYPE=s3)
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRATION=600
