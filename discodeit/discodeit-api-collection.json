{
  "info": {
    "name": "Discodeit API",
    "_postman_id": "discodeit-api-collection-v2",
    "description": "Discodeit Discord 클론 REST API 자동화 테스트 컬렉션\n\n## 실행 순서 (반드시 이 순서대로)\n01. Users → 02. Auth → 03. Channels → 04. Messages → 05. ReadStatuses → 06. BinaryContents → 07. Cleanup\n\n## 주의사항\n- 각 폴더를 순서대로 실행해야 ID 자동 연결이 됩니다\n- BinaryContents는 프로필/첨부파일 없이 테스트 시 자동 스킵됩니다\n- Cleanup은 마지막에 실행하세요 (채널·사용자 삭제 시 관련 데이터 연쇄 삭제)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:8080", "type": "string" },
    { "key": "userId",           "value": "", "type": "string" },
    { "key": "channelId",        "value": "", "type": "string" },
    { "key": "privateChannelId", "value": "", "type": "string" },
    { "key": "messageId",        "value": "", "type": "string" },
    { "key": "readStatusId",     "value": "", "type": "string" },
    { "key": "binaryContentId",  "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Users",
      "description": "사용자 CRUD (삭제는 07. Cleanup에서)",
      "item": [
        {
          "name": "사용자 생성",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userCreateRequest",
                  "value": "{\n  \"username\": \"testUser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
                  "contentType": "application/json",
                  "type": "text"
                },
                {
                  "key": "profile",
                  "type": "file",
                  "src": [],
                  "disabled": true,
                  "description": "프로필 이미지 첨부 시 활성화 → binaryContentId 자동 저장"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"사용자 생성 성공 (201)\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"응답 필드 확인\", function() {",
                  "    pm.expect(res.id).to.be.a(\"string\");",
                  "    pm.expect(res.username).to.eql(\"testUser\");",
                  "    pm.expect(res.email).to.eql(\"test@example.com\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"userId\", res.id);",
                  "if (res.profileId) {",
                  "    pm.collectionVariables.set(\"binaryContentId\", res.profileId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "전체 사용자 목록 조회",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"목록 조회 성공 (200)\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"배열 응답\", function() {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.be.an(\"array\");",
                  "    pm.expect(res.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "사용자 정보 수정",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userUpdateRequest",
                  "value": "{\n  \"newUsername\": null,\n  \"newEmail\": \"updated@example.com\",\n  \"newPassword\": null\n}",
                  "contentType": "application/json",
                  "type": "text",
                  "description": "newUsername·newPassword는 null → 변경 없음, email만 수정"
                },
                {
                  "key": "profile",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"사용자 수정 성공 (200)\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"email 변경 확인\", function() {",
                  "    pm.expect(res.email).to.eql(\"updated@example.com\");",
                  "});",
                  "pm.test(\"username 유지 확인\", function() {",
                  "    pm.expect(res.username).to.eql(\"testUser\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "온라인 상태 업데이트",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/userStatus",
              "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}","userStatus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newLastActiveAt\": \"{{$isoTimestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"온라인 상태 업데이트 성공 (200)\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"lastActiveAt 포함\", function() {",
                  "    pm.expect(pm.response.json().lastActiveAt).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Auth",
