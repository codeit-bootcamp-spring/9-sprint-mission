    {
      "name": "06. BinaryContents",
      "description": "프로필 또는 첨부파일 업로드 시에만 동작 (binaryContentId가 없으면 자동 스킵)",
      "item": [
        {
          "name": "파일 단건 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/binaryContents/{{binaryContentId}}",
              "host": ["{{baseUrl}}"], "path": ["api","binaryContents","{{binaryContentId}}"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Postman v8.6+ 에서는 요청 자체를 스킵",
                  "if (!pm.collectionVariables.get('binaryContentId')) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// binaryContentId 가 없으면 테스트 자체를 통과 처리 (구버전 Postman 대응)",
                  "const binaryContentId = pm.collectionVariables.get('binaryContentId');",
                  "if (!binaryContentId) {",
                  "    pm.test('파일 단건 조회 스킵 - binaryContentId 미설정 (사용자 생성 또는 메시지 생성 시 파일 첨부 필요)', function() {",
                  "        pm.expect(true).to.be.true;",
                  "    });",
                  "    return;",
                  "}",
                  "pm.test('파일 조회 성공 (200)', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('응답 필드 확인', function() {",
                  "    pm.expect(res.id).to.be.a('string');",
                  "    pm.expect(res.fileName).to.be.a('string');",
                  "    pm.expect(res.contentType).to.be.a('string');",
                  "    pm.expect(res.size).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "파일 다건 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/binaryContents?binaryContentIds={{binaryContentId}}",
              "host": ["{{baseUrl}}"], "path": ["api","binaryContents"],
              "query": [{ "key": "binaryContentIds", "value": "{{binaryContentId}}" }]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Postman v8.6+ 에서는 요청 자체를 스킵",
                  "if (!pm.collectionVariables.get('binaryContentId')) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// binaryContentId 가 없으면 테스트 자체를 통과 처리 (구버전 Postman 대응)",
                  "const binaryContentId = pm.collectionVariables.get('binaryContentId');",
                  "if (!binaryContentId) {",
                  "    pm.test('파일 다건 조회 스킵 - binaryContentId 미설정 (사용자 생성 또는 메시지 생성 시 파일 첨부 필요)', function() {",
                  "        pm.expect(true).to.be.true;",
                  "    });",
                  "    return;",
                  "}",
                  "pm.test('파일 목록 조회 성공 (200)', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('배열 응답', function() {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
