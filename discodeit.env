# Spring Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=80

# Application Configuration
STORAGE_TYPE=s3
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=discodeit-binary-content-storage-neb
AWS_S3_PRESIGNED_URL_EXPIRATION=600

# DataSource Configuration
RDS_ENDPOINT=discodeit-db.c1ig0uegaldx.ap-northeast-2.rds.amazonaws.com
SPRING_DATASOURCE_URL=jdbc:postgresql://discodeit-db.c1ig0uegaldx.ap-northeast-2.rds.amazonaws.com:5432/discodeit
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

JVM_OPTS=-Xmx512m -Xms256m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC
