# Spring Configuration
SPRING_PROFILES_ACTIVE=prod

# Application Configuration
STORAGE_TYPE=s3
AWS_S3_ACCESS_KEY=엑세스_키
AWS_S3_SECRET_KEY=시크릿_키
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=discodeit-binary-content-storage-lyi-sb9
AWS_S3_PRESIGNED_URL_EXPIRATION=600

# DataSource Configuration
RDS_ENDPOINT=discodeit-db-lyi-sb9.cdq6ku4m6g8g.ap-northeast-2.rds.amazonaws.com
SPRING_DATASOURCE_URL=jdbc:postgresql://discodeit-db-lyi-sb9.cdq6ku4m6g8g.ap-northeast-2.rds.amazonaws.com/discodeit
SPRING_DATASOURCE_USERNAME=discodeit_user
SPRING_DATASOURCE_PASSWORD=discodeit1234

# JVM Configuration (프리티어 고려)
JVM_OPTS=-Xmx512m -Xms256m -XX:MaxMetaspaceSize=64m -XX:+UseSerialGC"
